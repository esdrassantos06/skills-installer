{
  "name": "skills-installer",
  "version": "0.1.7",
  "description": "Desktop GUI to install agent skills from skills.sh in batch for Claude Code, Cursor, Codex, OpenCode, Antigravity, and other agents.",
  "main": "out/main/index.js",
  "license": "MIT",
  "author": "Esdras Santos",
  "homepage": "https://github.com/esdrassantos06/skills-installer",
  "repository": {
    "type": "git",
    "url": "https://github.com/esdrassantos06/skills-installer.git"
  },
  "bugs": {
    "url": "https://github.com/esdrassantos06/skills-installer/issues"
  },
  "keywords": [
    "claude-code",
    "agent-skills",
    "skills.sh",
    "electron",
    "installer",
    "ai-tools",
    "cursor",
    "antigravity"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-electron-binary.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:all": "electron-vite build && electron-builder -mwl",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^4.1.6",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.1.13",
    "vitest": "^4.1.6"
  }
}
